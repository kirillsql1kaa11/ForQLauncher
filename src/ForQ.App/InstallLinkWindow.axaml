<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ForQ.App.InstallLinkWindow"
        Title="Установка по ссылке"
        Width="600" Height="270" MinWidth="480" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Margin="24,22,24,12" Spacing="5">
            <TextBlock Text="УСТАНОВКА ПО ССЫЛКЕ" Classes="section" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="Подойдёт ссылка на проект Modrinth или прямая ссылка на файл .jar, .zip или .mrpack." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="24,0,24,0" Spacing="6">
            <TextBox x:Name="LinkBox" PlaceholderText="https://modrinth.com/mod/sodium" KeyDown="OnKeyDown" />
            <TextBlock x:Name="ErrorText" Classes="danger" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="24,16,24,22">
            <Button Content="Отмена" Classes="ghost" Click="OnCancel" />
            <Button Content="Установить" Classes="accent" Click="OnInstall" />
        </StackPanel>
    </Grid>
</Window>
